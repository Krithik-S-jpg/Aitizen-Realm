[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="Camera2D" type="Camera2D" parent="."]
script = ExtResource("2_camera")

[node name="World" parent="." instance=ExtResource("3_world_scene")]

[node name="UI" type="CanvasLayer" parent="."]

[node name="DebugPanel" type="Control" parent="UI"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("4_hud")

[node name="MarginContainer" type="MarginContainer" parent="UI/DebugPanel"]
layout_mode = 1
anchors_preset = 0
offset_right = 40.0
offset_bottom = 40.0
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20

[node name="VBoxContainer" type="VBoxContainer" parent="UI/DebugPanel/MarginContainer"]
layout_mode = 2

[node name="ConnectionStatus" type="Label" parent="UI/DebugPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Connection Status: Disconnected"

[node name="BackendURL" type="Label" parent="UI/DebugPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Backend URL: http://127.0.0.1:8000/api/v1/world"

[node name="WorldSize" type="Label" parent="UI/DebugPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "World Size: N/A"

[node name="ChunkSize" type="Label" parent="UI/DebugPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Chunk Size: N/A"

[node name="LoadedTileCount" type="Label" parent="UI/DebugPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Loaded Tile Count: N/A"

[node name="FPS" type="Label" parent="UI/DebugPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "FPS: 0"

[node name="TPS" type="Label" parent="UI/DebugPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "TPS: N/A"

[node name="RetryButton" type="Button" parent="UI/DebugPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Retry Connection"

[node name="TileInspector" type="Control" parent="UI"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("5_inspector")

[node name="PanelContainer" type="PanelContainer" parent="UI/TileInspector"]
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -320.0
offset_top = -240.0
offset_right = -20.0
offset_bottom = -20.0
grow_horizontal = 0
grow_vertical = 0

[node name="VBoxContainer" type="VBoxContainer" parent="UI/TileInspector/PanelContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="UI/TileInspector/PanelContainer/VBoxContainer"]
