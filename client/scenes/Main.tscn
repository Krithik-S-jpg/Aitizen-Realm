[gd_scene load_steps=9 format=3 uid="uid://cxmainscene"]

[ext_resource type="Script" path="res://scripts/core/Main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/camera/CameraController.gd" id="2_camera"]
[ext_resource type="PackedScene" path="res://scenes/World.tscn" id="3_world_scene"]
[ext_resource type="Script" path="res://scripts/ui/DebugHUD.gd" id="4_hud"]
[ext_resource type="Script" path="res://scripts/ui/TileInspector.gd" id="5_inspector"]
